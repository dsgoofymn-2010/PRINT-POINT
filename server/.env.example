NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

DATABASE_URL=postgresql://printpoint:printpoint@localhost:5432/printpoint?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-xxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxxxxx
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Razorpay TEST mode keys (Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-webhook-secret

# Uploads
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
# Delete order files this many hours after an order is completed/cancelled
FILE_RETENTION_HOURS=24
# Delete files never attached to a paid order after this many hours
ORPHAN_FILE_RETENTION_HOURS=72

# OTP: "console" logs codes; in development DEV_OTP is always accepted
SMS_PROVIDER=console
DEV_OTP=123456

DEFAULT_COMMISSION_PERCENT=5
