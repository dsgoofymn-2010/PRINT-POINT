# ==========================================================================
#  PRINT POINT - deploy settings
#  Copy this file to "deploy-settings.env" and fill it in there.
#  deploy-settings.env is git-ignored, so your secrets never get pushed.
#  These values are NOT read automatically - paste each one into the
#  matching dashboard (see DEPLOY.md).
# ==========================================================================


# --------------------------------------------------------------------------
#  1. SUPABASE  (database)
#  Supabase -> your project -> Connect -> "Session pooler" -> copy the URI
#  Replace [YOUR-PASSWORD] with your database password.
# --------------------------------------------------------------------------
SUPABASE_DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres


# --------------------------------------------------------------------------
#  2. YOUR LIVE URLS  (fill in after the first deploy of each)
#  No slash at the end.
# --------------------------------------------------------------------------
FRONTEND_URL=https://your-app.vercel.app
BACKEND_URL=https://your-api.onrender.com


# ==========================================================================
#  3. RENDER  -> backend service -> Environment  (paste these)
# ==========================================================================
NODE_ENV=production
DATABASE_URL=            # = SUPABASE_DATABASE_URL above
CORS_ORIGINS=            # = FRONTEND_URL above (add more with commas)
APP_URL=                 # = FRONTEND_URL above
COOKIE_SAMESITE=none     # keep as "none": frontend and backend are on different domains

# Make each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Razorpay -> Account & Settings -> API Keys (leave empty to skip online payment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional (these defaults are fine)
MAX_FILE_SIZE_MB=25
DEFAULT_COMMISSION_PERCENT=5


# ==========================================================================
#  4. VERCEL  -> project -> Settings -> Environment Variables  (paste these)
# ==========================================================================
VITE_API_URL=            # = BACKEND_URL above
VITE_MAX_FILE_MB=25      # keep same as MAX_FILE_SIZE_MB
