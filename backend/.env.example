NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
# Set to "none" when the frontend is on another domain (Vercel + Render)
COOKIE_SAMESITE=strict

DATABASE_URL=postgresql://printpoint:printpoint@localhost:5432/printpoint?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-xxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxxxxx
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Razorpay TEST mode keys (Dashboard -> Account & Settings -> API Keys).
# Leave empty to skip online payment: shops then collect payment at the counter.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-webhook-secret

# Uploads: 'local' (UPLOAD_DIR folder) or 'supabase' (private bucket; use this on Render,
# whose disk is wiped on every deploy). The service role key is server-only: never put it in the frontend.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=uploads
MAX_FILE_SIZE_MB=25
# Files are deleted at pickup / deny / cancel. These are safety nets:
# delete files of finished orders after this many hours
FILE_RETENTION_HOURS=24
# delete uploads not used by a live request this many hours after upload
ORPHAN_FILE_RETENTION_HOURS=24
# File preview/download links stop working after this many seconds
SIGNED_URL_TTL_SECONDS=300

# Print requests one customer can send per 10 minutes
REQUEST_RATE_LIMIT=10

# OTP: "console" logs codes; in development DEV_OTP is always accepted
SMS_PROVIDER=console
DEV_OTP=123456

DEFAULT_COMMISSION_PERCENT=5

# Test mode: skip login and switch roles with one click. Local development only.
# In production the server refuses to start with this on, unless ALLOW_DEMO_IN_PROD=true.
DEV_SKIP_LOGIN=true
ALLOW_DEMO_IN_PROD=false

# Which shop this app serves (its slug). Leave empty to use the oldest approved shop.
SHOP_SLUG=
