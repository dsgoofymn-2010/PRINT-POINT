# Leave empty in dev: Vite proxies /api to the server. Set when the API lives on another origin.
VITE_API_URL=
# Keep in sync with the server's MAX_FILE_SIZE_MB (used for the client-side check)
VITE_MAX_FILE_MB=25

# Test mode: skip login, switch roles from a bar at the bottom (dev only)
VITE_SKIP_LOGIN=false
